{
  "includeCoAuthoredBy": false,
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  },
  "enabledPlugins": {},
  "alwaysThinkingEnabled": true,
  "permissions": {
    "allow": [
      "Bash(workmux add:*)",
      "Bash(workmux wait:*)",
      "Bash(workmux status:*)",
      "Bash(workmux capture:*)",
      "Bash(workmux run:*)",
      "Bash(workmux send:*)",
      "Bash(workmux remove:*)",
      "Bash(gh push:*)",
      "Bash(gh release:*)"
    ]
  },
  "hooks": {
      "Notification": [ ],
      "PostToolUse": [ ],
      "Stop": [ ],
      "UserPromptSubmit": [ ]
    },
  "skipDangerousModePermissionPrompt": true
}
